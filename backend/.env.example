PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/school_management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=https://school-management-mauve-zeta.vercel.app,http://localhost:3000,*

# Cloud Storage Configuration (options: 'cloudinary' | 'cloudflare_r2' | 'local')
STORAGE_PROVIDER=cloudinary

# 1. Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively, full URL: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# 2. Cloudflare R2 Storage Configuration (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=school-management-photos
R2_PUBLIC_URL=https://pub-your_r2_subdomain.r2.dev

